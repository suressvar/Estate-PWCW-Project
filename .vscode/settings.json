{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.integration-app/**": true,
    "**/data/*.bak": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/coverage/**": true,
    "**/.turbo/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.integration-app": true,
    "**/test-results": true,
    "**/playwright-report": true
  },
  "files.autoSave": "off",
  "files.autoSaveDelay": 2000,
  "files.autoSaveWhenNoErrors": true,
  "editor.formatOnSave": false,
  "diffEditor.renderSideBySide": true
}
