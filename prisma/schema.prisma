datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Dynamic Role definitions configurable by Admins.
model Role {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String     @unique // e.g., "Admin", "Manager", "Field Staff"
  
  // Per-module fine-grained permission flags
  canManagePlots       Boolean    @default(false)
  canManageCrops       Boolean    @default(false)
  canLogFertilizer     Boolean    @default(false)
  canLogDiesel         Boolean    @default(false)
  canLogMachinery      Boolean    @default(false)
  canLogLabor          Boolean    @default(false)
  canLogProduction     Boolean    @default(false)
  canLogSales          Boolean    @default(false)
  canViewReports       Boolean    @default(false)
  canManageUsers       Boolean    @default(false)

  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  userRoles             UserRole[]

  @@map("roles")
}

/// Links Supabase Auth users to their dynamic Roles.
model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid // Maps to auth.users.id
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("user_roles")
}

/// Master table for Plots.
model Plot {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique
  location    String?
  areaAcres   Decimal          @map("area_acres") @db.Decimal(10, 2)
  status      PlotStatus       @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  plotCrops   PlotCrop[]
  assignments PlotAssignment[]

  @@map("plots")
}

enum PlotStatus {
  ACTIVE
  INACTIVE
}

/// Master table for Crops/Activities.
model CropActivity {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String           @unique // e.g., "Tomato", "Fertilizer apply", "Tomato tieing"
  type      CropActivityType @default(CROP)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  plotCrops PlotCrop[]

  @@map("crop_activities")
}

enum CropActivityType {
  CROP
  ACTIVITY
}

/// Join table representing active tracking of a Crop or Activity on a Plot.
model PlotCrop {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plotId         String         @map("plot_id") @db.Uuid
  cropActivityId String         @map("crop_activity_id") @db.Uuid
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  status         TrackingStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  plot                 Plot                  @relation(fields: [plotId], references: [id], onDelete: Cascade)
  cropActivity         CropActivity          @relation(fields: [cropActivityId], references: [id], onDelete: Cascade)
  fertilizerLogs       FertilizerLog[]
  machineryLogs        MachineryLog[]
  laborLogs            LaborLog[]
  productionLogs       ProductionLog[]
  salesLogs            SalesLog[]
  generalPurchaseLogs  GeneralPurchaseLog[]

  @@unique([plotId, cropActivityId, startDate])
  @@map("plot_crops")
}

enum TrackingStatus {
  ACTIVE
  COMPLETED
}

/// Links field staff users to specific plots they are authorized to manage/view.
model PlotAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid // Maps to auth.users.id
  plotId    String   @map("plot_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  plot      Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@unique([userId, plotId])
  @@map("plot_assignments")
}

/// Transaction type for stocks.
enum StockTransactionType {
  PURCHASE
  CONSUMPTION
}

/// Fertilizer logs (Purchase and Consumption).
model FertilizerLog {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plotCropId      String?              @map("plot_crop_id") @db.Uuid // Nullable for general purchases/stocking
  transactionType StockTransactionType @map("transaction_type")
  fertilizerName  String               @map("fertilizer_name") // e.g., "Urea", "NPK"
  quantityKg      Decimal              @map("quantity_kg") @db.Decimal(10, 2)
  cost            Decimal              @db.Decimal(12, 2) // Purchase cost or consumption value
  date            DateTime             @db.Date
  loggedBy        String               @map("logged_by") @db.Uuid // auth.users.id
  createdAt       DateTime             @default(now()) @map("created_at")
  notes           String?

  plotCrop        PlotCrop?            @relation(fields: [plotCropId], references: [id], onDelete: SetNull)

  @@map("fertilizer_logs")
}

/// Diesel logs (Purchase and Consumption).
model DieselLog {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionType StockTransactionType @map("transaction_type")
  quantityLiters  Decimal              @map("quantity_liters") @db.Decimal(10, 2)
  cost            Decimal              @db.Decimal(12, 2) // Cost of purchase
  date            DateTime             @db.Date
  loggedBy        String               @map("logged_by") @db.Uuid // auth.users.id
  createdAt       DateTime             @default(now()) @map("created_at")
  notes           String?

  @@map("diesel_logs")
}

/// Machinery usage logs.
model MachineryLog {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plotCropId           String   @map("plot_crop_id") @db.Uuid
  machineName          String   @map("machine_name") // e.g., "John Deere", "VST Tiller", "Rotavator"
  startTime            DateTime @map("start_time")
  endTime              DateTime @map("end_time")
  dieselConsumedLiters Decimal  @map("diesel_consumed_liters") @db.Decimal(10, 2)
  date                 DateTime @db.Date
  loggedBy             String   @map("logged_by") @db.Uuid // auth.users.id
  createdAt            DateTime @default(now()) @map("created_at")
  notes                String?

  plotCrop             PlotCrop @relation(fields: [plotCropId], references: [id], onDelete: Cascade)

  @@map("machinery_logs")
}

/// Labor usage logs.
model LaborLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plotCropId     String   @map("plot_crop_id") @db.Uuid
  date           DateTime @db.Date
  menCount       Int      @map("men_count")
  womenCount     Int      @map("women_count")
  menWageRate    Decimal  @map("men_wage_rate") @db.Decimal(10, 2)
  womenWageRate  Decimal  @map("women_wage_rate") @db.Decimal(10, 2)
  loggedBy       String   @map("logged_by") @db.Uuid // auth.users.id
  createdAt      DateTime @default(now()) @map("created_at")
  notes          String?

  plotCrop       PlotCrop @relation(fields: [plotCropId], references: [id], onDelete: Cascade)

  @@map("labor_logs")
}

/// Production / Harvest logs.
model ProductionLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plotCropId String   @map("plot_crop_id") @db.Uuid
  date       DateTime @db.Date
  quantityKg Decimal  @map("quantity_kg") @db.Decimal(10, 2)
  loggedBy   String   @map("logged_by") @db.Uuid // auth.users.id
  createdAt  DateTime @default(now()) @map("created_at")
  notes      String?

  plotCrop   PlotCrop @relation(fields: [plotCropId], references: [id], onDelete: Cascade)

  @@map("production_logs")
}

/// Sales logs.
model SalesLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plotCropId String   @map("plot_crop_id") @db.Uuid
  date       DateTime @db.Date
  quantityKg Decimal  @map("quantity_kg") @db.Decimal(10, 2)
  value      Decimal  @db.Decimal(12, 2) // Revenue received
  buyerName  String?  @map("buyer_name")
  loggedBy   String   @map("logged_by") @db.Uuid // auth.users.id
  createdAt  DateTime @default(now()) @map("created_at")
  notes      String?

  plotCrop   PlotCrop @relation(fields: [plotCropId], references: [id], onDelete: Cascade)

  @@map("sales_logs")
}

/// General purchases / Miscellaneous logs.
model GeneralPurchaseLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plotCropId  String?  @map("plot_crop_id") @db.Uuid // Nullable if not tied to a specific crop
  date        DateTime @db.Date
  description String
  cost        Decimal  @db.Decimal(12, 2)
  loggedBy    String   @map("logged_by") @db.Uuid // auth.users.id
  createdAt   DateTime @default(now()) @map("created_at")
  notes       String?

  plotCrop    PlotCrop? @relation(fields: [plotCropId], references: [id], onDelete: SetNull)

  @@map("general_purchase_logs")
}

// ==========================================
// 1. CHART OF ACCOUNTS (PROMPT 3)
// ==========================================
enum GroupType {
  EXPENSE
  INCOME
  LIABILITY
  ASSET
}

enum PnLSide {
  DEBIT
  CREDIT
}

model LedgerGroup {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupName      String          @unique @map("group_name")
  description    String?
  groupType      GroupType       @default(EXPENSE) @map("group_type")
  pnlSide        PnLSide         @default(DEBIT) @map("pnl_side")
  linkedCategory String?         @map("linked_category")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  ledgers        ExpenseLedger[]

  @@map("ledger_groups")
}

model ExpenseLedger {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ledgerName    String             @unique @map("ledger_name")
  groupId       String             @map("group_id") @db.Uuid
  description   String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  group         LedgerGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  goatPurchases Purchase[]
  feedPurchases FeedPurchase[]
  medPurchases  MedicinePurchase[]
  vacPurchases  VaccinePurchase[]
  otherVouchers OtherVoucher[]
  goatSales     SalesRecord[]
  otherSales    OtherSalesRecord[]

  @@map("expense_ledgers")
}

// ==========================================
// 2. PURCHASE VOUCHERS (PROMPT 1)
// ==========================================
model Purchase {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerName     String         @map("seller_name")
  purchaseDate   DateTime       @map("purchase_date") @db.Date
  billDate       DateTime?      @map("bill_date") @db.Date
  billNo         String?        @map("bill_no")
  tagId          String         @unique @map("tag_id")
  breed          String?
  gender         String?
  weight         Decimal?       @db.Decimal(10, 2)
  price          Decimal        @db.Decimal(12, 2)
  ledgerId       String?        @map("ledger_id") @db.Uuid
  pnlCategory    String         @default("Purchase") @map("pnl_category")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  ledger         ExpenseLedger? @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@map("purchases")
}

model FeedPurchase {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedName       String         @map("feed_name")
  quantity       Decimal        @db.Decimal(10, 2)
  unit           String?
  cost           Decimal        @db.Decimal(12, 2)
  purchaseDate   DateTime       @map("purchase_date") @db.Date
  billDate       DateTime?      @map("bill_date") @db.Date
  billNo         String?        @map("bill_no")
  supplier       String?
  ledgerId       String?        @map("ledger_id") @db.Uuid
  pnlCategory    String         @default("Purchase") @map("pnl_category")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  ledger         ExpenseLedger? @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@map("feed_purchases")
}

model MedicinePurchase {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicineName   String         @map("medicine_name")
  doseUnit       String?        @map("dose_unit")
  quantity       Decimal        @db.Decimal(10, 2)
  cost           Decimal        @db.Decimal(12, 2)
  purchaseDate   DateTime       @map("purchase_date") @db.Date
  billDate       DateTime?      @map("bill_date") @db.Date
  billNo         String?        @map("bill_no")
  supplier       String?
  ledgerId       String?        @map("ledger_id") @db.Uuid
  pnlCategory    String         @default("Purchase") @map("pnl_category")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  ledger         ExpenseLedger? @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@map("medicine_purchases")
}

model VaccinePurchase {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vaccineName    String         @map("vaccine_name")
  quantity       Decimal        @db.Decimal(10, 2)
  cost           Decimal        @db.Decimal(12, 2)
  purchaseDate   DateTime       @map("purchase_date") @db.Date
  billDate       DateTime?      @map("bill_date") @db.Date
  billNo         String?        @map("bill_no")
  supplier       String?
  ledgerId       String?        @map("ledger_id") @db.Uuid
  pnlCategory    String         @default("Purchase") @map("pnl_category")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  ledger         ExpenseLedger? @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@map("vaccine_purchases")
}

model OtherVoucher {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherDate    DateTime       @map("voucher_date") @db.Date
  supplierName   String?        @map("supplier_name")
  ledgerId       String?        @map("ledger_id") @db.Uuid
  billDate       DateTime?      @map("bill_date") @db.Date
  billNo         String?        @map("bill_no")
  quantity       Decimal?       @db.Decimal(10, 2)
  unitName       String?        @map("unit_name")
  amount         Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  pnlCategory    String         @default("Direct Expenses") @map("pnl_category")
  createdAt      DateTime       @default(now()) @map("created_at")

  ledger         ExpenseLedger? @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@map("other_vouchers")
}

// ==========================================
// 3. SALES MODULE (PROMPT 2)
// ==========================================
model SalesRecord {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  srNo            String?        @map("sr_no")
  tagId           String         @map("tag_id")
  breed           String?
  breedPercent    String?        @map("breed_percent")
  gender          String?
  weight          Decimal?       @db.Decimal(10, 2)
  soldPrice       Decimal        @map("sold_price") @db.Decimal(12, 2)
  dateOfSale      DateTime       @map("date_of_sale") @db.Date
  buyerName       String?        @map("buyer_name")
  buyerCity       String?        @map("buyer_city")
  buyerContact    String?        @map("buyer_contact")
  ledgerId        String?        @map("ledger_id") @db.Uuid
  pnlCategory     String         @default("Sales") @map("pnl_category")
  invoiceGroupId  String?        @map("invoice_group_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")

  ledger          ExpenseLedger? @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@map("sales_records")
}

model OtherSalesRecord {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  srNo            String?        @map("sr_no")
  itemName        String         @map("item_name")
  quantity        Decimal        @db.Decimal(10, 2)
  unit            String?
  pricePerUnit    Decimal        @map("price_per_unit") @db.Decimal(10, 2)
  totalAmount     Decimal        @map("total_amount") @db.Decimal(12, 2)
  dateOfSale      DateTime       @map("date_of_sale") @db.Date
  buyerName       String?        @map("buyer_name")
  buyerCity       String?        @map("buyer_city")
  buyerContact    String?        @map("buyer_contact")
  ledgerId        String?        @map("ledger_id") @db.Uuid
  pnlCategory     String         @default("Sales") @map("pnl_category")
  notes           String?
  invoiceGroupId  String?        @map("invoice_group_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")

  ledger          ExpenseLedger? @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@map("other_sales_records")
}

// ==========================================
// 4. HR: EMPLOYEES, ATTENDANCE, WAGES, LEAVES (PROMPTS 4, 5, 6, 7)
// ==========================================
enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

enum WageType {
  DAILY
  MONTHLY
  HOURLY
}

model EmployeeRole {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleName    String     @unique @map("role_name")
  description String?
  employees   Employee[]

  @@map("employee_roles")
}

model Employee {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  phone            String?
  address          String?
  roleId           String?         @map("role_id") @db.Uuid
  joinDate         DateTime?       @map("join_date") @db.Date
  wageType         WageType        @default(DAILY) @map("wage_type")
  wageRate         Decimal         @default(0) @map("wage_rate") @db.Decimal(10, 2)
  status           EmployeeStatus  @default(ACTIVE)
  notes            String?
  photoPath        String?         @map("photo_path")
  emergencyContact String?         @map("emergency_contact")
  emergencyPhone   String?         @map("emergency_phone")
  aadhaarNo        String?         @map("aadhaar_no")
  bankAccountNo    String?         @map("bank_account_no")
  bankName         String?         @map("bank_name")
  ifscCode         String?         @map("ifsc_code")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  role             EmployeeRole?   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  attendances      Attendance[]
  wages            Wage[]
  leaves           Leave[]

  @@map("employees")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

model Attendance {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  status         AttendanceStatus
  checkInTime    String?          @map("check_in_time")
  checkOutTime   String?          @map("check_out_time")
  notes          String?
  recordedBy     String?          @map("recorded_by")
  createdAt      DateTime         @default(now()) @map("created_at")

  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, attendanceDate])
  @@map("attendance")
}

enum WageStatus {
  PENDING
  PAID
}

model Wage {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String      @map("employee_id") @db.Uuid
  month            Int
  year             Int
  workingDays      Int         @default(0) @map("working_days")
  presentDays      Decimal     @default(0) @map("present_days") @db.Decimal(5, 2)
  absentDays       Decimal     @default(0) @map("absent_days") @db.Decimal(5, 2)
  wageRate         Decimal     @map("wage_rate") @db.Decimal(10, 2)
  wageType         WageType    @map("wage_type")
  grossSalary      Decimal     @default(0) @map("gross_salary") @db.Decimal(12, 2)
  deductions       Decimal     @default(0) @db.Decimal(12, 2)
  bonus            Decimal     @default(0) @db.Decimal(12, 2)
  netSalary        Decimal     @default(0) @map("net_salary") @db.Decimal(12, 2)
  paymentDate      DateTime?   @map("payment_date") @db.Date
  paymentMode      String?     @map("payment_mode")
  paymentReference String?     @map("payment_reference")
  status           WageStatus  @default(PENDING)
  notes            String?
  calculatedAt     DateTime    @default(now()) @map("calculated_at")

  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@map("wages")
}

enum LeaveType {
  CASUAL
  SICK
  EMERGENCY
  UNPAID
}

enum LeaveStatus {
  APPROVED
  PENDING
  REJECTED
}

model Leave {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String      @map("employee_id") @db.Uuid
  leaveType   LeaveType   @map("leave_type")
  fromDate    DateTime    @map("from_date") @db.Date
  toDate      DateTime    @map("to_date") @db.Date
  totalDays   Decimal     @map("total_days") @db.Decimal(5, 2)
  reason      String?
  status      LeaveStatus @default(APPROVED)
  approvedBy  String?     @map("approved_by")
  appliedDate DateTime    @default(now()) @map("applied_date") @db.Date
  notes       String?

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leaves")
}

// ==========================================
// 5. STOCK & VALUATIONS (PROMPTS 8 & 10)
// ==========================================
model ManualStockValuation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodName   String   @map("period_name")
  fromDate     DateTime @map("from_date") @db.Date
  toDate       DateTime @map("to_date") @db.Date
  openingStock Decimal  @default(0) @map("opening_stock") @db.Decimal(14, 2)
  closingStock Decimal  @default(0) @map("closing_stock") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("manual_stock_valuations")
}

model InventoryItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemType      String    @map("item_type") // FEED, MEDICINE, VACCINE
  name          String
  openingStock  Decimal   @default(0) @map("opening_stock") @db.Decimal(10, 2)
  purchasedQty  Decimal   @default(0) @map("purchased_qty") @db.Decimal(10, 2)
  usedQty       Decimal   @default(0) @map("used_qty") @db.Decimal(10, 2)
  wastageQty    Decimal   @default(0) @map("wastage_qty") @db.Decimal(10, 2)
  closingStock  Decimal   @default(0) @map("closing_stock") @db.Decimal(10, 2)
  unit          String?
  costPerUnit   Decimal   @default(0) @map("cost_per_unit") @db.Decimal(10, 2)
  totalCost     Decimal   @default(0) @map("total_cost") @db.Decimal(12, 2)
  supplier      String?
  alertLevel    Decimal   @default(0) @map("alert_level") @db.Decimal(10, 2)
  lastUpdated   DateTime  @default(now()) @updatedAt @map("last_updated")

  @@map("inventory_items")
}
